# ============================================================
# AdsIQ — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# ⚠️  NEVER commit your .env file to git!
#     .env is already in .gitignore
# ============================================================

# ------------------------------------------------------------
# 🗄️  DATABASE — PostgreSQL
# ------------------------------------------------------------
# PostgreSQL connection string format:
#   postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
POSTGRES_URL=postgresql://adsiq_user:adsiq_pass@localhost:5432/adsiq_db
POSTGRES_USER=adsiq_user
POSTGRES_PASSWORD=adsiq_pass
POSTGRES_DB=adsiq_db

# ------------------------------------------------------------
# ⚡ CACHE — Redis
# ------------------------------------------------------------
# Redis is used for: caching API responses, WebSocket pubsub,
# and as a Celery task queue broker
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# 🤖 AI / LLM KEYS
# ------------------------------------------------------------
# OpenAI — Used for GPT-4o (primary LLM for all agents)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini — Alternative LLM (optional)
# Get yours at: https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=your-gemini-key-here

# Which LLM to use as default: "openai" or "gemini"
DEFAULT_LLM_PROVIDER=openai

# ------------------------------------------------------------
# 🔍 OBSERVABILITY — LangSmith
# ------------------------------------------------------------
# LangSmith traces every agent step so you can debug and
# understand exactly what the AI is doing.
# Sign up at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-key-here
LANGCHAIN_PROJECT=adsiq-platform

# ------------------------------------------------------------
# 🔐 SECURITY
# ------------------------------------------------------------
# Secret key for JWT token signing (use a long random string)
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# 🌐 APP CONFIG
# ------------------------------------------------------------
# Backend API URL (what the frontend calls)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Environment: "development" | "production"
ENVIRONMENT=development

# Enable demo mode (uses mock data, no real API keys needed)
DEMO_MODE=true

# ------------------------------------------------------------
# 🎯 GOOGLE ADS API (Optional — for real integration)
# ------------------------------------------------------------
# These are OPTIONAL. In DEMO_MODE=true, the app simulates
# all Google Ads API calls with realistic mock data.
# For real integration, get credentials at:
# https://developers.google.com/google-ads/api/docs/first-call/overview
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
